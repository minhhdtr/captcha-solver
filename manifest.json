{
  "manifest_version": 3,
  "name": "Captcha Solver",
  "description": "Captcha Solver extension",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hoadondientu.gdt.gov.vn/*",
        "https://tracuunnt.gdt.gov.vn/tcnnt/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
